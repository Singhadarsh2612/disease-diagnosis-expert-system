# Flask settings
FLASK_DEBUG=true
PORT=5000

# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: set to true to force Python fallback even if clipspy is installed
FORCE_FALLBACK_ENGINE=false

# Doctor Portal (shared login). CHANGE THESE.
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=change-me-123
# Long random string used to sign login tokens
SECRET_KEY=replace-with-a-long-random-string
